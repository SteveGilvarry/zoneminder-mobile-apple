# Live-backend credentials for the contract tests. Copy to `.env` (gitignored) and fill in.
# Source it before running tests so the values land in the environment:
#
#   set -a; source .env; set +a
#   swift test            # or: xcodebuild test -scheme ZmMobileCore ...
#
# If ZM_USERNAME / ZM_PASSWORD are unset, the live contract test soft-skips.
ZM_BASE_URL=http://zoneminder.local:8080
ZM_USERNAME=admin
ZM_PASSWORD=
